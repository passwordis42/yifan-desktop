<Window
    x:Class="Yifan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Yifan.Views"
    Title="一翻"
    Width="880"
    Height="696"
    MinWidth="760"
    MinHeight="560">
    <Grid Background="#F4F1EA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#F7F4EE" BorderBrush="#E6E0D4" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4" Margin="8,12,8,0">
                <Button x:Name="HomeNav" Click="HomeNav_Click" HorizontalContentAlignment="Left" Background="#FFFFFF" BorderThickness="0" CornerRadius="8" Padding="10,8">
                    <TextBlock Text="主页" FontSize="14" Foreground="#2C2A26" />
                </Button>
                <Button x:Name="SettingsNav" Click="SettingsNav_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,8">
                    <TextBlock Text="设置" FontSize="14" Foreground="#2C2A26" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="16,0,16,16" TextWrapping="Wrap" FontSize="12" Foreground="#6F6A60"
                       Text="关掉本窗口不会退出，热键仍可用。" />
        </Grid>
        <Grid Grid.Column="1">
            <views:HomePage x:Name="Home" />
            <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
