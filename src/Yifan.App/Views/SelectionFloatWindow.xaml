<Window
    x:Class="Yifan.Views.SelectionFloatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="一翻 · 划词">
    <Border Background="#FFFEFB" BorderBrush="#E6E0D4" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Row="0" Background="#FBFAF6" Padding="10,8" ColumnSpacing="6"
                  PointerPressed="Title_PointerPressed" PointerMoved="Title_PointerMoved" PointerReleased="Title_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="BrandMark" Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Text="一翻 · 划词" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2C2A26" />
                <TextBlock Grid.Column="2" Text="拖动" FontSize="11" Foreground="#9A9488" VerticalAlignment="Center" />
                <Button x:Name="ZoomButton" Grid.Column="3" Content="放大" Click="Zoom_Click" Padding="8,2" MinWidth="0" />
                <TextBlock x:Name="PairLabel" Grid.Column="4" Text="EN → 中文" Foreground="#2F6FED" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="5" Content="×" Click="Close_Click" Padding="8,0" MinWidth="28" />
            </Grid>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="14,12,14,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="SourceRule" BorderBrush="#D9D2C4" BorderThickness="3,0,0,0" Padding="10,0,0,0" Margin="0,0,0,10">
                        <TextBlock x:Name="SourceText" FontSize="13" Foreground="#6F6A60" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>
                    <TextBlock x:Name="TranslationText" FontSize="15" FontWeight="SemiBold" Foreground="#2C2A26" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Border x:Name="ErrorBox" Visibility="Collapsed" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" Foreground="#B42318" />
                            <TextBlock x:Name="ErrorBody" TextWrapping="Wrap" Foreground="#B42318" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="LanguageRow" Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="14,0,14,8" Visibility="Collapsed">
                <TextBlock Text="目标语言" VerticalAlignment="Center" FontSize="12" Foreground="#6F6A60" />
                <ComboBox x:Name="TargetBox" MinWidth="140" SelectionChanged="TargetBox_SelectionChanged" />
            </StackPanel>
            <StackPanel x:Name="Actions" Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="14,0,14,12" />
        </Grid>
    </Border>
</Window>
