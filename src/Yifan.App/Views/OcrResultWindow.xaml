<Window
    x:Class="Yifan.Views.OcrResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="截图识译">
    <Grid x:Name="Root">
        <Border Background="#FFFEFB" BorderBrush="#E6E0D4" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="TitleBar" Background="#FBFAF6" Padding="10,8" ColumnSpacing="6"
                      PointerPressed="Title_PointerPressed" PointerMoved="Title_PointerMoved" PointerReleased="Title_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="18" Height="18" CornerRadius="4" Background="#C42B1C" />
                    <TextBlock Grid.Column="1" Text="截图识译" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel x:Name="FontTools" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="Smaller" Content="A−" Click="Smaller_Click" Padding="6,0" MinWidth="28" />
                        <TextBlock Text="12–22" FontSize="11" VerticalAlignment="Center" Foreground="#6F6A60" />
                        <Button x:Name="Larger" Content="A+" Click="Larger_Click" Padding="6,0" MinWidth="28" />
                    </StackPanel>
                    <Button x:Name="ZoomButton" Grid.Column="3" Content="放大" Click="Zoom_Click" Padding="8,2" />
                    <Button Grid.Column="5" Content="×" Click="Close_Click" Padding="8,0" MinWidth="28" />
                </Grid>
                <Grid Grid.Row="1">
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Padding="16" Spacing="8" HorizontalAlignment="Center">
                        <ProgressRing IsActive="True" Width="28" Height="28" />
                        <TextBlock Text="正在识字…" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="加载中固定位置与大小，不可拖改" FontSize="12" Foreground="#6F6A60" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer x:Name="BodyScroll" Padding="12">
                        <StackPanel Spacing="8">
                            <Border x:Name="Thumb" Height="64" CornerRadius="8" Background="#F4F1EA" Visibility="Collapsed">
                                <Grid>
                                    <Image x:Name="ThumbImage" Stretch="UniformToFill" />
                                    <TextBlock x:Name="ThumbLabel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="11" Foreground="#6F6A60" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="SourceLabel" Text="识别原文" FontSize="12" Foreground="#6F6A60" Visibility="Collapsed" />
                            <TextBlock x:Name="SourceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="TranslationLabel" Text="译文" FontSize="12" Foreground="#2F6FED" Visibility="Collapsed" />
                            <TextBlock x:Name="TranslationText" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" Foreground="#B42318" />
                                    <TextBlock x:Name="ErrorBody" TextWrapping="Wrap" Foreground="#B42318" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
        <Canvas x:Name="Handles" IsHitTestVisible="False">
            <Border x:Name="HandleN" Canvas.Left="0" Canvas.Top="0" Width="28" Height="8" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="n" />
            <Border x:Name="HandleS" Width="28" Height="8" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="s" />
            <Border x:Name="HandleE" Width="8" Height="28" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="e" />
            <Border x:Name="HandleW" Width="8" Height="28" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="w" />
            <Border x:Name="HandleNw" Width="10" Height="10" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="nw" />
            <Border x:Name="HandleNe" Width="10" Height="10" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="ne" />
            <Border x:Name="HandleSw" Width="10" Height="10" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="sw" />
            <Border x:Name="HandleSe" Width="10" Height="10" Background="#2F6FED" Opacity="0" CornerRadius="3" Tag="se" />
        </Canvas>
    </Grid>
</Window>
