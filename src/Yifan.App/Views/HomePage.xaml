<UserControl
    x:Class="Yifan.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,22,28,24">
        <StackPanel Spacing="12" MaxWidth="760">
            <TextBlock Text="主页" FontSize="28" FontWeight="SemiBold" Foreground="#2C2A26" />
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ServiceTitle" FontSize="16" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="ServiceBody" TextWrapping="Wrap" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ServiceSwitch" Grid.Column="1" OffContent="" OnContent="" MinWidth="0" Toggled="ServiceSwitch_Toggled" />
                </Grid>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectionCard" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <Border x:Name="SelectionChip" Background="#EAF1FF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="SelectionChord" FontWeight="Bold" Foreground="#2F6FED" />
                        </Border>
                        <TextBlock x:Name="SelectionTitle" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="SelectionBody" TextWrapping="Wrap" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                </Border>
                <Border x:Name="CropCard" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <Border Background="#EAF1FF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="CropChord" FontWeight="Bold" Foreground="#2F6FED" />
                        </Border>
                        <TextBlock x:Name="CropTitle" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="CropBody" TextWrapping="Wrap" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="KpiRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前厂商" FontSize="12" Foreground="#6F6A60" />
                        <TextBlock x:Name="ProviderName" FontSize="18" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="ProviderLine" TextWrapping="Wrap" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="语言" FontSize="12" Foreground="#6F6A60" />
                        <TextBlock x:Name="LanguageLine" FontSize="18" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ExtraRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="术语本" FontSize="12" Foreground="#6F6A60" />
                        <TextBlock x:Name="GlossaryLine" FontSize="18" FontWeight="SemiBold" Foreground="#2C2A26" />
                        <TextBlock x:Name="GlossaryHint" FontSize="13" Foreground="#6F6A60" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <Button x:Name="OcrButton" Style="{StaticResource SoftButton}" HorizontalAlignment="Stretch" Click="OcrButton_Click" Content="截图识译" />
                        <TextBlock x:Name="OcrHint" TextAlignment="Center" FontSize="12" Foreground="#6F6A60" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="WarnBanner" Visibility="Collapsed" Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="10" Padding="12">
                <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="#B54708" />
            </Border>
            <TextBlock x:Name="HotkeyWarning" TextWrapping="Wrap" FontSize="12" Foreground="#B54708" />
            <TextBlock x:Name="Permission" TextWrapping="Wrap" FontSize="12" Foreground="#6F6A60" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
