<Application
    x:Class="Yifan.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PaperBg" Color="#F4F1EA" />
            <SolidColorBrush x:Key="PaperCard" Color="#FFFEFB" />
            <SolidColorBrush x:Key="InkBrush" Color="#2C2A26" />
            <SolidColorBrush x:Key="MutedBrush" Color="#6F6A60" />
            <SolidColorBrush x:Key="LineBrush" Color="#E6E0D4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF" />
            <SolidColorBrush x:Key="TitleBrush" Color="#FBFAF6" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF3F2" />
            <SolidColorBrush x:Key="WarnBrush" Color="#B54708" />
            <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFFAEB" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PaperCard}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="#2F6FED" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#2F6FED" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,8" />
            </Style>
            <Style x:Key="SoftButton" TargetType="Button">
                <Setter Property="Background" Value="#EAF1FF" />
                <Setter Property="Foreground" Value="#2F6FED" />
                <Setter Property="BorderBrush" Value="#C8D7FB" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="#2C2A26" />
                <Setter Property="BorderBrush" Value="#E6E0D4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
